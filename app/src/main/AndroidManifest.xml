<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Raw TCP to the frame. LAN traffic still needs INTERNET. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Observing the Wi-Fi network so sockets are bound to it rather than cellular. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The send queue runs as a dataSync foreground service with a progress notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Optional: without it sends still work, only the progress notification is missing. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      ACCESS_LOCAL_NETWORK is deliberately absent. It is mandatory only for apps targeting
      SDK 37+, and the platform docs are explicit that apps targeting 36 or lower must NOT
      declare it. It is added in the same change that raises targetSdk to 37.
      See Spec/00 - Initial/02 - Architecture.md §8.1.
    -->

    <application
        android:name=".FrameAltApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FrameAlt"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The share-sheet entry. Its own activity so it runs in the sharing app's task (finishing
          returns there) and holds the URI grant for the whole flow. See ShareActivity.

          SEND_MULTIPLE also accepts */*: a mixed share (photos plus a PDF or a video) arrives
          with that as its common type, and UX §5 asks for the photos to go through with the
          rest counted as skipped. Single shares stay image-only so FrameAlt is not offered
          for text and links.
        -->
        <activity
            android:name=".ui.share.ShareActivity"
            android:exported="true"
            android:label="@string/share_label"
            android:theme="@style/Theme.FrameAlt"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- WorkManager's own foreground service, given the type Android 14+ requires. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <receiver
            android:name=".send.CancelSendReceiver"
            android:exported="false" />
    </application>

</manifest>
